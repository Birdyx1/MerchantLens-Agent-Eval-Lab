{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merchant Agent Negative Annotation v1",
  "type": "object",
  "required": ["schema_version", "task_id", "task_sha256", "fixture_sha256", "reviewer_id", "submitted_at", "judgment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "judgment": {
      "type": "object", "required": ["category", "expected_behavior", "forbidden_tools", "evidence_note"],
      "additionalProperties": false,
      "properties": {
        "category": {"enum": ["ambiguous", "dirty_input"]},
        "expected_behavior": {"enum": ["clarify", "reject"]},
        "forbidden_tools": {"type": "array", "minItems": 1, "uniqueItems": true,
                            "items": {"enum": ["get_store_net", "search_web", "execute_python"]}},
        "evidence_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
