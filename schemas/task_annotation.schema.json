{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merchant Agent Independent Task Annotation v1",
  "type": "object",
  "required": ["schema_version", "task_id", "task_sha256", "fixture_sha256", "reviewer_id", "submitted_at", "judgment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "judgment": {
      "type": "object",
      "required": ["solvable", "expected_amount_fen", "store_id", "evidence_note"],
      "additionalProperties": false,
      "properties": {
        "solvable": {"type": "boolean"},
        "expected_amount_fen": {"type": ["integer", "null"], "minimum": 0},
        "store_id": {"type": ["string", "null"], "minLength": 1},
        "evidence_note": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"solvable": {"const": true}}},
        "then": {
          "properties": {
            "expected_amount_fen": {"type": "integer"},
            "store_id": {"type": "string", "minLength": 1}
          }
        },
        "else": {
          "properties": {
            "expected_amount_fen": {"type": "null"},
            "store_id": {"type": "null"}
          }
        }
      }]
    }
  }
}
