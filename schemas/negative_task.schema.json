{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merchant Agent Negative Task v1",
  "type": "object",
  "required": ["schema_version", "task_id", "task_type", "rubric_id", "rubric_sha256", "input", "environment", "oracle", "provenance", "label_status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "task_type": {"const": "negative_input"},
    "rubric_id": {"const": "negative_input_v1"},
    "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {
      "type": "object", "required": ["user_request"], "additionalProperties": false,
      "properties": {"user_request": {"type": "string", "minLength": 1}}
    },
    "environment": {
      "type": "object", "required": ["fixture_path", "fixture_sha256"], "additionalProperties": false,
      "properties": {
        "fixture_path": {"type": "string", "minLength": 1},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "oracle": {
      "type": "object", "required": ["category", "expected_behavior", "forbidden_tools"], "additionalProperties": false,
      "properties": {
        "category": {"enum": ["ambiguous", "dirty_input"]},
        "expected_behavior": {"enum": ["clarify", "reject"]},
        "forbidden_tools": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["get_store_net", "search_web", "execute_python"]}
        }
      }
    },
    "provenance": {
      "type": "object", "required": ["kind", "source_ref"], "additionalProperties": false,
      "properties": {
        "kind": {"const": "adversarial"},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "label_status": {"enum": ["draft", "adjudicated"]}
  }
}
